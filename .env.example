# VisionInspect AI - Environment Variables Configuration Template
# Copy this file to .env before running docker compose or local services.

# Application Environment
ENVIRONMENT=development

# Database Connections
DATABASE_URL=postgresql://postgres:postgres@db:5432/visioninspect
MONGO_URI=mongodb://mongodb:27017/
MONGO_DB_NAME=visioninspect

# AI Model Configuration
MODEL_PATH=yolov8n.pt

# Security & Authentication
SECRET_KEY=visioninspect_secret_key_change_in_production_2026

# Service URLs
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Cloudflare Tunnel Configuration (Optional)
# Paste your Cloudflare Zero Trust tunnel token below to securely expose containers publicly
CLOUDFLARE_TUNNEL_TOKEN=
